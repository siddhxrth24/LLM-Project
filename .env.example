# === SemesTrack Configuration ===

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/semestrack.db

# File storage
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma

# Models
LLM_MODEL_ID=Qwen/Qwen3.5-0.8B
LLM_MODEL_PATH=./models/llm
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_PATH=./models/embeddings

# LoRA
LORA_ADAPTER_PATH=
LORA_ENABLED=false

# Inference
MAX_NEW_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.9
CONTEXT_WINDOW=2048

# Fine-tuning defaults
FINETUNE_BATCH_SIZE=1
FINETUNE_GRAD_ACCUM_STEPS=4
FINETUNE_EPOCHS=3
FINETUNE_LR=2e-4
FINETUNE_LORA_RANK=8
FINETUNE_MAX_SEQ_LEN=512

# OCR (optional)
TESSERACT_PATH=
OCR_ENABLED=false

# Security
SECRET_KEY=change-me-in-production
